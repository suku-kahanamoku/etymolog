---
import ThemeInit from "../modules/UIModule/components/ThemeInit.astro";
import SeoHead from "../modules/SiteModule/components/SeoHead.astro";
import "../styles/global.css";
import ConsentScript from "../modules/AdsModule/components/ConsentScript.astro";
import AdFrame from "../modules/AdsModule/components/AdFrame.astro";
import Header from "../modules/SiteModule/components/Header.astro";
import Footer from "../modules/SiteModule/components/Footer.astro";
import { dictionary } from "../modules/SiteModule/providers/translations";
import { type Locale } from "../modules/LangModule/providers/locale";
import { type PageId } from "../config/routes";
import { site } from "../config/site";
/**
 * Základní rozvržení webu: hlavička s přepínačem motivu, SEO hlavička, zápatí
 * a reklamní rám. Obsah stránky se vkládá do výchozího slotu, doplňující
 * prvky do `<head>` přes slot `head`.
 * Props: položky bez `?` jsou povinné, u volitelných uvádí popis výchozí hodnotu.
 */
interface Props {
  /** Jazyk stránky; zároveň se vypisuje do `lang` a `data-theme`. */
  locale: Locale;
  /** Aktuální stránka pro menu a hlavičky SEO; u detailu a chyb se vynechá. */
  page?: PageId;
  /** Titulek stránky (kombinuje se se značkou webu v SEO hlavičce). */
  title: string;
  /** Popis stránky pro vyhledávače a sociální sítě. */
  description: string;
  /** Zakáže indexování stránky; výchozí `false`. */
  noindex?: boolean;
}
const { locale, page, title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang={locale} data-theme={site.theme.name}>
  <head>
    <meta charset="utf-8" />
    {site.modules.ads && <ConsentScript />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.theme.color} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <SeoHead {locale} {page} {title} {description} {noindex} />
    <ThemeInit />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      {dictionary(locale).common.skip}
    </a>
    <AdFrame {locale} enabled={site.modules.ads && !Astro.locals.privatePage}>
      <Header {locale} {page} />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <Footer {locale} />
    </AdFrame>
  </body>
</html>
