---
import "../styles/components.css";
import Section from "../../UIModule/components/Section.astro";
import { dictionary } from "../providers/translations";
import { type Locale } from "../../LangModule/providers/locale";
/**
 * Přihlašovací formulář AuthModule.
 *
 * Formulář se odesílá přímo metodou POST na `/api/auth/login/`, takže funguje i
 * bez JavaScriptu; server pak přesměruje zpět na stránku s kódem chyby.
 * Props: položky bez `?` jsou povinné, u volitelných uvádí popis výchozí hodnotu.
 */
interface Props {
  /** Jazyk, ve kterém se vykreslí popisky a vrací se přesměrování po úspěchu. */
  locale: Locale;
}
const { locale } = Astro.props;
const t = dictionary(locale);
/** Kód chyby z dotazu (`invalid` nebo `unavailable`), jinak `null`. */
const error = Astro.url.searchParams.get("error");
---

<Section contentClass="auth-section">
  <div class="card auth-card">
    <p class="eyebrow">{t.auth.eyebrow}</p>
    <h1>{t.auth.title}</h1>
    <p>{t.auth.description}</p>
    {error && (
      <p class="alert alert-error" role="alert">
        {error === "invalid" ? t.auth.invalid : t.auth.unavailable}
      </p>
    )}
    <form
      data-native-pending
      method="post"
      action="/api/auth/login/"
      class="auth-form"
    >
      <input type="hidden" name="locale" value={locale} />
      <label>
        {t.auth.email}
        <input
          class="input w-full"
          name="email"
          type="email"
          autocomplete="username"
          required
          maxlength="254"
        />
      </label>
      <label>
        {t.auth.password}
        <input
          class="input w-full"
          name="password"
          type="password"
          autocomplete="current-password"
          required
          maxlength="1024"
        />
      </label>
      <button class="btn btn-primary" type="submit">
        {t.auth.submit}
        <span aria-hidden="true">→</span>
      </button>
    </form>
  </div>
</Section>

<script>
  import { useNativeFormPending } from "../../UIModule/hooks/useFormPending";
  useNativeFormPending(
    document.querySelector<HTMLFormElement>("[data-native-pending]"),
  );
</script>
