---
import { externalLinkAttributes } from "../../UIModule/providers/external-links";
import { Image } from "astro:assets";
import archive from "../assets/archive.png";
import { dictionary } from "../providers/translations";
import type { Locale } from "../../LangModule/config";
interface Props {
  locale: Locale;
  title: string;
  body: string;
  link: string;
  href: string;
}
const { locale, title, body, link, href } = Astro.props;
---

<section class="page-section">
  <div class="section-inner section-pad archive-note">
    <Image src={archive} width={420} alt="" class="archive-note-image" />
    <div>
      <p class="eyebrow">ETYMOLOG · EX FONTIBUS</p>
      <h2>{title}</h2>
      <p>{body}</p>
      <a
        class="text-link"
        href={href}
        {...externalLinkAttributes(href, Astro.url)}
      >
        {link}
      </a>
      <small>{dictionary(locale).about.visual}</small>
    </div>
  </div>
</section>
<style>
  .archive-note {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 3rem;
    align-items: center;
  }
  .archive-note-image {
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }
  .archive-note h2 {
    font-size: 2rem;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .archive-note p:not(.eyebrow) {
    color: var(--muted);
    font-size: 0.9rem;
    max-width: 65ch;
  }
  .archive-note small {
    display: block;
    color: var(--muted);
    font-size: 0.6rem;
  }
  .archive-note .eyebrow {
    margin-bottom: 0.8rem;
  }
  :global([data-theme="newspaper-dark"]) .archive-note-image {
    mix-blend-mode: normal;
    opacity: 0.8;
  }
  @media (max-width: 640px) {
    .archive-note {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .archive-note-image {
      max-width: 220px;
      justify-self: center;
    }
  }
</style>
