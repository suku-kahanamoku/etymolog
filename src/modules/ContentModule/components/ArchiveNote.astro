---
import { dictionary } from "../providers/translations";
import type { Locale } from "../../LangModule/config";
/** Dvousloupcové představení projektu a práce s prameny na domovské stránce. */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const about = dictionary(locale).about;
---

<section class="page-section paper-section">
  <div class="section-inner section-pad archive-note">
    <article>
      <h2 class="rule-title">{about.title}</h2>
      <p>{about.description}</p>
      <p>{about.visual}</p>
    </article>
    <article>
      <h2 class="rule-title">{about.method}</h2>
      <p>{about.body}</p>
    </article>
  </div>
</section>
<style>
  .archive-note {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 4rem);
  }
  .archive-note article {
    min-width: 0;
  }
  .archive-note .rule-title {
    white-space: normal;
  }
  .archive-note p {
    font-family: Georgia, serif;
    font-size: 1.05rem;
  }
  @media (max-width: 767px) {
    .archive-note {
      grid-template-columns: 1fr;
    }
  }
</style>
