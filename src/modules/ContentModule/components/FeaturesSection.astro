---
import "../styles/components.css";
import Section from "../../UIModule/components/Section.astro";
import FeatureCard from "./FeatureCard.astro";
import { dictionary } from "../providers/translations";
import type { Locale } from "../../LangModule/config";
/**
 * Sekce s přehledem funkcí (ContentModule); karty čerpá ze slovníku ContentModule.
 * Props: položky bez `?` jsou povinné, u volitelných uvádí popis výchozí hodnotu.
 */
interface Props {
  /** Jazyk, ve kterém se vykreslí nadpis a popis sekce. */
  locale: Locale;
}
const t = dictionary(Astro.props.locale);
---

<Section contentClass="features-section" background="var(--color-base-200)">
  <div class="section-heading">
    <h2>{t.home.section}</h2>
    <p>{t.home.intro}</p>
  </div>
  <div class="feature-grid">
    {t.home.cards.map((card, index) => (
      <FeatureCard {...card} number={index + 1} />
    ))}
  </div>
</Section>
