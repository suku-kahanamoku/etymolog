---
import "../styles/components.css";
import { ads, type AdPosition } from "../../../config/ads";
import { dictionary } from "../providers/translations";
import { type Locale } from "../../LangModule/providers/locale";
/**
 * Jeden reklamní slot AdsModule.
 *
 * Slot pouze vykreslí kontejner s konfigurací jednotky v `data-ad-unit`; skutečné
 * vykreslení reklamy zajistí `mountAds()` až po souhlasu CMP a pouze když je
 * slot viditelný a dostatečně široký pro formát.
 * Props: položky bez `?` jsou povinné, u volitelných uvádí popis výchozí hodnotu.
 */
interface Props {
  /** Pozice slotu v rozvržení (`top`, `left`, `right`). */
  position: AdPosition;
  /** Jazyk, ve kterém se vykreslí popisky slotu. */
  locale: Locale;
}
const { position, locale } = Astro.props;
const t = dictionary(locale);
const unit = ads[position];
---

<aside class:list={["ad-slot", `ad-${position}`]} aria-label={t.ad}>
  <span class="ad-label">{t.ad}</span>
  <div
    id={`ad-${position}`}
    class:list={[
      "ad-content",
      { "ad-content-seznam": unit.provider === "seznam" },
    ]}
    data-ad-unit={JSON.stringify(unit)}
  >
    <span class="ad-placeholder">{t.adSpace}</span>
  </div>
</aside>
