---
import "../styles/components.css";
import AdSlot from "./AdSlot.astro";
import { site } from "../../../config/site";
import type { Locale } from "../../LangModule/config";
/**
 * Reklamní rám AdsModule.
 *
 * Rozmístí sloty kolem obsahu stránky a spustí načítání jednotek přes `useAds()`.
 * Při vypnutí reklam (`enabled: false`, vypnutý modul nebo neveřejná stránka)
 * se sloty vůbec nevykreslí a žádný skript se nespouští.
 * Props: položky bez `?` jsou povinné, u volitelných uvádí popis výchozí hodnotu.
 */
interface Props {
  /** Jazyk, ve kterém se vykreslí popisky slotů. */
  locale: Locale;
  /** Zapnout reklamní sloty; výchozí hodnota se řídí přepínačem `site.modules.ads`. */
  enabled?: boolean;
}
const { locale, enabled = site.modules.ads } = Astro.props;
---

<div class:list={["site-frame", { "with-ads": enabled }]}>
  {enabled && (
    <div class="top-ad-reveal" data-top-ad-reveal>
      <AdSlot position="top" {locale} />
    </div>
  )}
  {enabled && <AdSlot position="left" {locale} />}
  <div class="site-content">
    <slot />
  </div>
  {enabled && <AdSlot position="right" {locale} />}
</div>
<script>
  import { useAds } from "../hooks/useAds";
  import { onDocumentDispose } from "../../UIModule/hooks/onDocumentDispose";
  onDocumentDispose(useAds());
</script>
