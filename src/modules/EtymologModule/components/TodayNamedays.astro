---
import type { Locale } from "../../LangModule/config";
import type { Entry, TodayNamedays } from "../types";
import { dictionary } from "../providers/translations";
import { nameUrl } from "../../../config/routes";
interface Props {
  locale: Locale;
  data?: TodayNamedays;
  narratives?: Record<number, Pick<Entry, "type" | "body">>;
}
const { locale, data, narratives = {} } = Astro.props;
const t = dictionary(locale);
const date = data
  ? new Intl.DateTimeFormat(locale, {
      dateStyle: "long",
      timeZone: "Europe/Prague",
    }).format(new Date(data.date + "T12:00:00Z"))
  : undefined;
---

<section class="page-section today-section" aria-label={t.today.title}>
  <div class="section-inner section-pad today-namedays">
    {data && (
      <h2 class="today-date">
        <time datetime={data.date}>{date}</time>
      </h2>
    )}
    {!data ? (
      <p role="status">{t.today.error}</p>
    ) : data.items.length === 0 ? (
      <p>{t.today.empty}</p>
    ) : (
      <ul class="today-list">
        {data.items.map((item) => {
          const narrative = narratives[item.name_id];
          return (
            <li>
              <a class="today-name" href={nameUrl(locale, item.name_id)}>
                {item.name}
              </a>
              {narrative && (
                <div class="today-narrative">
                  <h3>
                    {t.types[narrative.type as "etymology" | "mythology"]}
                  </h3>
                  <p>{narrative.body}</p>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    )}
  </div>
</section>
<style>
  .today-section {
    background: #fff;
  }
  :global([data-theme="newspaper-dark"]) .today-section {
    background: var(--color-base-100);
  }
  .today-date {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    margin: 0 0 1.5rem;
  }
  .today-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 2rem;
    list-style: none;
    padding: 0;
  }
  .today-list li {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .today-name {
    font-family: Georgia, serif;
    font-size: 2rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .today-narrative h3 {
    font-size: 1.1rem;
    margin: 1rem 0 0.35rem;
  }
  .today-narrative p {
    margin: 0;
    white-space: pre-line;
    max-width: 70ch;
  }
</style>
