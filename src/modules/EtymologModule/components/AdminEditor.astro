---
import type { Locale } from "../../LangModule/config";
import { dictionary } from "../providers/translations";
import { resources } from "../config/resources";
import "../styles/admin.css";
interface Props {
  locale: Locale;
  isAdmin: boolean;
}
const { locale, isAdmin } = Astro.props;
const t = dictionary(locale);
---

<div
  class="etymolog-admin"
  data-admin
  data-text={JSON.stringify(t)}
  data-admin-role={isAdmin ? "admin" : "user"}
>
  <nav class="admin-resources" aria-label={t.admin.title}>
    {Object.entries(resources)
      .filter(([, d]) => !d.admin || isAdmin)
      .map(([key]) => (
        <button type="button" data-resource={key}>
          {(t.resources as Record<string, string>)[key]}
        </button>
      ))}
  </nav>
  <div class="admin-workspace">
    <div class="admin-toolbar">
      <h2 data-resource-title class="rule-title">
        {t.resources.names}
      </h2>
      <div class="admin-toolbar-actions">
        {isAdmin && (
          <button class="btn btn-outline" data-sync-start type="button" hidden>
            {t.admin.syncStart}
          </button>
        )}
        <button class="btn btn-primary" data-create type="button">
          + {t.admin.new}
        </button>
      </div>
    </div>
    {isAdmin && (
      <div data-sync-panel hidden>
        <p class="editor-help">{t.admin.syncHelp}</p>
        <p data-sync-status role="status" aria-live="polite"></p>
      </div>
    )}
    <form data-filter class="admin-filter">
      <label for="admin-filter">{t.admin.filter}</label>
      <div>
        <input id="admin-filter" name="q" maxlength="255" />
        <button class="btn btn-outline" type="submit">
          {t.admin.filterSubmit}
        </button>
        <button class="btn btn-ghost" type="button" data-refresh>
          {t.admin.refresh}
        </button>
      </div>
    </form>
    <p data-admin-status role="status" aria-live="polite"></p>
    <div class="data-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th data-list-label>{t.fields.title}</th>
            <th>{t.admin.state}</th>
            <th>
              <span class="sr-only">{t.admin.edit}</span>
            </th>
          </tr>
        </thead>
        <tbody data-admin-rows></tbody>
      </table>
    </div>
    <div class="admin-pagination">
      <button type="button" class="btn btn-outline" data-prev>
        {t.previous}
      </button>
      <span data-admin-page></span>
      <button type="button" class="btn btn-outline" data-next>
        {t.next}
      </button>
    </div>
  </div>
  <dialog data-editor class="editor-dialog" aria-labelledby="editor-title">
    <div class="editor-dialog-body">
      <div class="admin-toolbar">
        <h2 id="editor-title"></h2>
        <button
          class="btn btn-ghost"
          type="button"
          data-close
          aria-label={t.admin.close}
        >
          ×
        </button>
      </div>
      <p class="editor-help">{t.admin.help}</p>
      <form data-edit-form>
        <div data-editor-fields class="editor-fields"></div>
        <details data-system>
          <summary>{t.admin.readonly}</summary>
          <pre data-system-values></pre>
        </details>
        <p data-editor-status role="status" aria-live="polite"></p>
        <div class="editor-actions">
          <button type="submit" class="btn btn-primary">
            {t.admin.save}
          </button>
          <button type="button" class="btn btn-outline" data-close>
            {t.admin.cancel}
          </button>
        </div>
      </form>
    </div>
  </dialog>
  <dialog data-evidence class="editor-dialog" aria-labelledby="evidence-title">
    <div class="editor-dialog-body">
      <div class="admin-toolbar">
        <h2 id="evidence-title">{t.admin.provenance}</h2>
        <button
          type="button"
          data-evidence-close
          class="btn btn-ghost"
          aria-label={t.admin.close}
        >
          ×
        </button>
      </div>
      <pre data-evidence-content></pre>
      <div class="admin-pagination">
        <button type="button" class="btn btn-outline" data-evidence-prev>
          {t.previous}
        </button>
        <span data-evidence-page></span>
        <button type="button" class="btn btn-outline" data-evidence-next>
          {t.next}
        </button>
      </div>
    </div>
  </dialog>
</div>
<script>
  import { useAdminEditor } from "../hooks/useAdminEditor";
  useAdminEditor();
</script>
