---
import { externalLinkAttributes } from "../../UIModule/providers/external-links";
import EditorialIcon from "../../UIModule/components/EditorialIcon.astro";
import type { Locale } from "../../LangModule/config";
import type { Dossier } from "../types";
import { dictionary } from "../providers/translations";
import { safeWebUrl } from "../providers/links";
import { url, nameUrl } from "../../../config/routes";
import "../styles/public.css";
/**
 * Veřejný detail jednoho jména (EtymologModule).
 *
 * Komponenta pouze seskupuje již projektovaná data z php-core do sekcí:
 * výklady podle typu, varianty, kalendářní tradice, zdroje a tabulku výskytů.
 * Odkazy ze zdrojů procházejí přes `safeWebUrl()`, takže se vykreslí jen
 * bezpečná `http(s)` URL, a u vnějších odkazů se přidává `noopener noreferrer`.
 * Props: položky bez `?` jsou povinné, u volitelných uvádí popis výchozí hodnotu.
 */
interface Props {
  /** Jazyk textů a návratových adres. */
  locale: Locale;
  /** Kompletní projektovaný detail záznamu z php-core. */
  data: Dossier;
}
const { locale, data } = Astro.props;
const t = dictionary(locale);
const {
  name,
  entries,
  variants,
  occurrences,
  calendar_days: days,
  sources,
  citations,
} = data;
/** Pořadí sekcí výkladů; pořadí je záměrné a odpovídá významu jednotlivých typů. */
const narrativeOrder = [
  "etymology",
  "mythology",
  "legend",
  "history",
  "clerical_error",
  "fiction",
  "tradition",
  "proverb",
] as const;
/** Výklady rozdělené podle typu, prázdné skupiny se vynechají (kromě základních). */
const groups = narrativeOrder
  .map((type) => ({
    type,
    label: t.types[type],
    items: entries.filter((e) => e.type === type),
  }))
  .filter(
    (g) => g.items.length || g.type === "etymology" || g.type === "mythology",
  );
/** Typy výkladů, které se označují jako kulturně podmíněné. */
const culture = ["legend", "mythology", "fiction", "tradition", "proverb"];
/** Odkazy ve výkladech, které nejsou pokryté žádným zdrojem ani citací. */
const extraEntrySources = entries.filter((entry) => {
  const link = safeWebUrl(entry.source_url);
  return (
    link &&
    !sources.some((s) => safeWebUrl(s.url) === link) &&
    !citations.some((c) => safeWebUrl(c.url) === link)
  );
});
/** `true`, pokud má záznam vlastní zdroje nebo odkazy ve výkladech mimo zdroje. */
const hasSources = sources.length > 0 || extraEntrySources.length > 0;
/**
 * @param key Klíč slovníku hodnot (např. druh svátku).
 * @returns Překlad hodnoty, nebo `—` pro prázdnou hodnotu.
 */
const valueLabel = (key: string | null) =>
  key ? ((t.values as Record<string, string>)[key] ?? key) : "—";
/**
 * @param from Počátek období.
 * @param to Konec období.
 * @returns Formátované rozmezí let, případně prázdný řetězec.
 */
const years = (from: number | null, to: number | null) =>
  [from, to].filter((v) => v !== null).join("–");
/** Obsah odkazového menu na začátku detailu. */
const sections = [
  ...groups.map((g) => ({ id: g.type, label: g.label })),
  ...(variants.length ? [{ id: "variants", label: t.variants }] : []),
  ...(days.length ? [{ id: "calendar", label: t.calendar }] : []),
  ...(hasSources ? [{ id: "sources", label: t.sources }] : []),
  ...(occurrences.length ? [{ id: "occurrences", label: t.occurrences }] : []),
];
---

<section class="page-section paper-section">
  <div class="section-inner section-pad dossier-header">
    <a class="text-link" href={url(locale)}>
      ← {t.back}
    </a>
    <p class="eyebrow">{t.dossier}</p>
    <h1 class="editorial-heading">{name.name}</h1>
    <div class="dossier-tags">
      <span>{t[name.kind]}</span>
      {name.country_code && <span>{name.country_code}</span>}
      {name.language && <span>{name.language.toUpperCase()}</span>}
    </div>
    {name.summary && <p class="editorial-lead prose-copy">{name.summary}</p>}
  </div>
</section>
<section class="page-section">
  <div class="section-inner section-pad dossier-body">
    <nav class="dossier-index" aria-label={t.contents}>
      <p>{t.contents}</p>
      {sections.map((section) => (
        <a href={`#${section.id}`}>{section.label}</a>
      ))}
    </nav>
    <div>
      {!sections.length && <p class="notice">{t.noDetails}</p>}
      {groups.map((group) => (
        <section class="dossier-group" id={group.type}>
          <h2 class="rule-title">
            <EditorialIcon
              name={
                culture.includes(group.type)
                  ? "story"
                  : group.type === "etymology"
                    ? "book"
                    : "history"
              }
            />
            {group.label}
          </h2>
          {!group.items.length && (
            <p class="notice">
              {group.type === "etymology"
                ? t.missingEtymology
                : t.missingMythology}
            </p>
          )}
          {group.items.length > 0 && culture.includes(group.type) && (
            <p class="cultural-note">{t.culturalNotice}</p>
          )}
          {group.items.map((entry) => (
            <article class="entry">
              <div class="entry-meta">
                <span class="certainty">
                  {(t.certainty as Record<string, string>)[entry.certainty] ??
                    entry.certainty}
                </span>
                <span>{entry.language.toUpperCase()}</span>
                {entry.region && <span>{entry.region}</span>}
                {(entry.year_from !== null || entry.year_to !== null) && (
                  <span>{years(entry.year_from, entry.year_to)}</span>
                )}
              </div>
              <h3>{entry.title}</h3>
              <p class="prose-copy entry-body" lang={entry.language}>
                {entry.body}
              </p>
            </article>
          ))}
        </section>
      ))}
      {variants.length > 0 && (
        <section id="variants" class="dossier-group">
          <h2 class="rule-title">
            <EditorialIcon name="branch" />
            {t.variants}
          </h2>
          <ul class="variant-list">
            {variants.map((v) => (
              <li>
                {v.target_name_id ? (
                  <a href={nameUrl(locale, v.target_name_id)}>{v.variant}</a>
                ) : (
                  v.variant
                )}
                {v.language && <small> · {v.language}</small>}
                <small class="variant-meta">
                  {(t.relations as Record<string, string>)[v.relation] ??
                    v.relation}
                  {v.region ? ` · ${v.region}` : ""}
                  {years(v.year_from, v.year_to)
                    ? ` · ${years(v.year_from, v.year_to)}`
                    : ""}
                </small>
              </li>
            ))}
          </ul>
        </section>
      )}
      {days.length > 0 && (
        <section id="calendar" class="dossier-group">
          <h2 class="rule-title">
            <EditorialIcon name="calendar" />
            {t.calendar}
          </h2>
          <p class="cultural-note">{t.calendarNote}</p>
          <div class="calendar-grid">
            {days.map((d) => (
              <article class="calendar-card">
                <span class="calendar-date">
                  {d.date_kind === "fixed"
                    ? `${d.day}. ${d.month}.`
                    : d.date_rule}
                </span>
                <h3>{d.title}</h3>
                <p>
                  {valueLabel(d.kind)} · {d.country_code}
                </p>
                <p>{valueLabel(d.system)}</p>
                <p>
                  {d.tradition}
                  {d.region ? ` · ${d.region}` : ""}
                  {years(d.year_from, d.year_to)
                    ? ` · ${years(d.year_from, d.year_to)}`
                    : ""}
                </p>
              </article>
            ))}
          </div>
        </section>
      )}
      {hasSources && (
        <section id="sources" class="dossier-group">
          <h2 class="rule-title">
            <EditorialIcon name="book" />
            {t.sources}
          </h2>
          <ol class="source-list">
            {sources.map((s) => (
              <li id={`source-${s.id}`}>
                <strong>{s.title}</strong>
                {s.author && <span> — {s.author}</span>}
                {safeWebUrl(s.url) && (
                  <p>
                    <a
                      href={safeWebUrl(s.url)}
                      {...externalLinkAttributes(safeWebUrl(s.url), Astro.url)}
                    >
                      {t.original}
                    </a>
                  </p>
                )}
                {citations
                  .filter((c) => Number(c.source_id) === Number(s.id))
                  .map((c) => (
                    <div class="entry-citation">
                      <span>
                        {
                          entries.find(
                            (entry) => Number(entry.id) === Number(c.entry_id),
                          )?.title
                        }
                      </span>
                      {c.locator && <span> · {c.locator}</span>}
                      {safeWebUrl(c.url) &&
                        safeWebUrl(c.url) !== safeWebUrl(s.url) && (
                          <>
                            {" · "}
                            <a
                              href={safeWebUrl(c.url)}
                              {...externalLinkAttributes(
                                safeWebUrl(c.url),
                                Astro.url,
                              )}
                            >
                              {t.original}
                            </a>
                          </>
                        )}
                      {c.quotation && (
                        <details>
                          <summary>{t.quotation}</summary>
                          <blockquote class="prose-copy">
                            {c.quotation}
                          </blockquote>
                        </details>
                      )}
                    </div>
                  ))}
                {variants
                  .filter((v) => Number(v.source_id) === Number(s.id))
                  .map((v) => (
                    <p>
                      {t.variants}: {v.variant}
                    </p>
                  ))}
                {occurrences
                  .filter((o) => Number(o.source_id) === Number(s.id))
                  .map((o) => (
                    <p>
                      {t.occurrences}: {o.observed_on ?? o.observed_year}
                      {o.country_code && <span> · {o.country_code}</span>}
                      {o.locator && <span> · {o.locator}</span>}
                    </p>
                  ))}
                {days
                  .filter((d) => Number(d.source_id) === Number(s.id))
                  .map((d) => (
                    <p>
                      {d.title}
                      {d.locator && <span> · {d.locator}</span>}
                      {safeWebUrl(d.source_url) && d.source_url !== s.url && (
                        <>
                          {" · "}
                          <a
                            href={safeWebUrl(d.source_url)}
                            {...externalLinkAttributes(
                              safeWebUrl(d.source_url),
                              Astro.url,
                            )}
                          >
                            {t.original}
                          </a>
                        </>
                      )}
                    </p>
                  ))}
                {s.license && (
                  <p>
                    {t.license}:{" "}
                    {safeWebUrl(s.license_url) ? (
                      <a
                        href={safeWebUrl(s.license_url)}
                        {...externalLinkAttributes(
                          safeWebUrl(s.license_url),
                          Astro.url,
                        )}
                      >
                        {s.license}
                      </a>
                    ) : (
                      s.license
                    )}
                  </p>
                )}
                {s.attribution && <p class="prose-copy">{s.attribution}</p>}
              </li>
            ))}
          </ol>
          {extraEntrySources.map((entry) => (
            <p>
              {entry.title}
              {" · "}
              <a
                href={safeWebUrl(entry.source_url)}
                {...externalLinkAttributes(
                  safeWebUrl(entry.source_url),
                  Astro.url,
                )}
              >
                {t.original}
              </a>
            </p>
          ))}
        </section>
      )}
      {occurrences.length > 0 && (
        <section id="occurrences" class="dossier-group">
          <h2 class="rule-title">
            <EditorialIcon name="history" />
            {t.occurrences}
          </h2>
          <div class="data-table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>{t.year}</th>
                  <th>{t.place}</th>
                  <th>
                    {t.measure} / {t.sex}
                  </th>
                  <th>{t.count}</th>
                </tr>
              </thead>
              <tbody>
                {occurrences.map((o) => (
                  <tr>
                    <td>{o.observed_on ?? o.observed_year}</td>
                    <td>
                      {[o.country_code, o.region].filter(Boolean).join(" · ")}
                    </td>
                    <td>
                      {valueLabel(o.measure)} / {valueLabel(o.sex)}
                      {o.original_spelling && <p>{o.original_spelling}</p>}
                    </td>
                    <td>
                      {o.count === null
                        ? "—"
                        : new Intl.NumberFormat(locale).format(o.count)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}
    </div>
  </div>
</section>
