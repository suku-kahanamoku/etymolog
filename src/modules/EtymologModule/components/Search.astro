---
import { dictionary } from "../providers/translations";
import type { Locale } from "../../LangModule/config";
import type { SearchResult } from "../types";
import SearchPanel from "./SearchPanel.astro";
import "../styles/public.css";
/**
 * Hledací formulář a výsledky EtymologModule (domovská stránka webu).
 *
 * Výsledky se vykreslí ze serverového dotazu `q`; po odeslání formuláře přebírá
 * načítání, překreslování a adresu v prohlížeči `useNameSearch()`, takže hledání
 * funguje i bez JavaScriptu (běžný GET na stránku).
 * Props: položky bez `?` jsou povinné, u volitelných uvádí popis výchozí hodnotu.
 */
interface Props {
  /** Jazyk výsledků a návratových adres. */
  locale: Locale;
  /** Výsledek vyhledání z routy; `undefined` při chybě nebo bez dotazu. */
  result?: SearchResult;
  /** Kód chyby hledání (`invalid` nebo `unavailable`); `undefined` = bez chyby. */
  error?: string;
  /** Aktuální hledaný řetězec (pro pole a odkazy na další stránky). */
  query?: string;
}
const { locale, result, error, query = "" } = Astro.props;
const t = dictionary(locale);
---

<section class="page-section paper-section">
  <div class="section-inner search-edition section-pad">
    <div class="edition-line">
      <span>{t.edition}</span>
      <span>EST. MMXXVI</span>
    </div>
    <div class="masthead">
      <p>ETYMOLOG</p>
      <span>{t.dossier}</span>
    </div>
    <div class="search-intro">
      <span class="printer-ornament" aria-hidden="true">
        ✦
      </span>
      <h1 class="editorial-heading">{t.headline}</h1>
      <p class="editorial-lead">{t.intro}</p>
    </div>
    <SearchPanel locale={locale} result={result} error={error} query={query} />
  </div>
</section>
