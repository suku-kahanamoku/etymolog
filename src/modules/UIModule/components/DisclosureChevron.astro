---
/**
 * Šipka označující rozbalovací prvek `details` (dekorativní, `aria-hidden`).
 * Props: položky bez `?` jsou povinné, u volitelných uvádí popis výchozí hodnotu.
 */
interface Props {
  /** Volitelná třída navíc ke `disclosure-chevron`. */
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={["disclosure-chevron", className]}
  width="16"
  height="16"
  viewBox="0 0 16 16"
  fill="none"
  aria-hidden="true"
>
  <path
    d="m4 6 4 4 4-4"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
