---
import { themeConfig } from "../config/theme";
---

<!--
  Nastaví motiv ještě před vykreslením stránky, aby nedošlo k blikání.
  Skript je `is:inline` a běží synchronně v `<head>`; konfigurace se předá
  přes `define:vars`, protože nesmí být součástí bundlu. Rozhoduje uložená
  volba v `localStorage`, jinak systémové `prefers-color-scheme`.
-->
<script is:inline define:vars={{ config: themeConfig }}>
  (() => {
    let preference;
    try {
      preference = localStorage.getItem(config.storageKey);
    } catch {
      /* Storage is optional. */
    }
    const valid =
      preference === config.light.name || preference === config.dark.name;
    const dark = valid
      ? preference === config.dark.name
      : matchMedia("(prefers-color-scheme: dark)").matches;
    const theme = dark ? config.dark : config.light;
    document.documentElement.dataset.theme = theme.name;
    document.documentElement.dataset.themeMode = dark ? "dark" : "light";
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", theme.color);
  })();
</script>
