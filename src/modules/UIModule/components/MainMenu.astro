---
import "../styles/main-menu.css";
import ThemeToggle from "./ThemeToggle.astro";
import NavigationLinks from "./NavigationLinks.astro";
import type { NavigationItem } from "../types";
/**
 * Hlavní menu webu: značka, desktopová navigace, motiv, jazyk, akce a mobilní panel.
 *
 * Texty a odkazy dostává výhradně přes props a sloty, takže UIModule nezná
 * žádný doménový obsah. Chování bez JavaScriptu zajišťuje blok `<noscript>`,
 * který mobilní panel vypíše staticky.
 * Props: položky bez `?` jsou povinné, u volitelných uvádí popis výchozí hodnotu.
 */
interface Props {
  /** Jazyk předávaný přepínači motivu. */
  locale: string;
  /** Přístupnostní popisky navigace (`aria-label` obou panelů). */
  label: string;
  /** Položky desktopové navigace. */
  items: NavigationItem[];
  /** Položky mobilního panelu; výchozí hodnotou je `items`. */
  mobileItems?: NavigationItem[];
  /** `id` mobilního panelu, na který odkazuje tlačítko přes `aria-controls`. */
  menuId?: string;
  /** `aria-label` tlačítka v zavřeném stavu. */
  openLabel?: string;
  /** `aria-label` tlačítka v otevřeném stavu. */
  closeLabel?: string;
  /** Přidá vizuální rámeček kolem hlavičky. */
  framed?: boolean;
  /** Vykreslit obsah slotu `action` v pravé části hlavičky. */
  showAction?: boolean;
}
const {
  locale,
  label,
  items,
  mobileItems = items,
  menuId = "mobile-navigation",
  openLabel = label,
  closeLabel = label,
  framed = false,
  showAction = true,
} = Astro.props;
---

<header
  class:list={["main-menu", "site-header", { "main-menu-framed": framed }]}
  data-main-menu
>
  <div class="header-inner">
    <div class="header-brand">
      <slot name="brand" />
    </div>
    <nav class="desktop-nav" aria-label={label}>
      <NavigationLinks {items} class="nav-link" />
    </nav>
    <div class="header-actions">
      <div class="header-preferences">
        <ThemeToggle {locale} />
        <slot name="language" />
      </div>
      {showAction && Astro.slots.has("action") && (
        <div class="header-primary-action">
          <slot name="action" />
        </div>
      )}
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls={menuId}
        aria-label={openLabel}
        data-open-label={openLabel}
        data-close-label={closeLabel}
        data-menu-toggle
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <nav id={menuId} class="mobile-nav" aria-label={label} hidden>
    <NavigationLinks items={mobileItems} class="nav-link" />
  </nav>
</header>
<script>
  import { useMainMenu } from "../hooks/useMainMenu";
  useMainMenu();
  document.addEventListener("astro:page-load", useMainMenu);
</script>
<noscript>
  <style is:global>
    @media (max-width: 1279px) {
      .main-menu .menu-toggle {
        display: none;
      }
      @layer base {
        /* Layered !important preflight needs an override in the same layer. */
        .main-menu .mobile-nav[hidden] {
          display: flex !important;
        }
      }
      .main-menu .mobile-nav[hidden] {
        display: flex !important;
        position: static;
        max-height: none;
        grid-column: 1 / -1;
      }
      .main-menu {
        position: relative;
      }
    }
  </style>
</noscript>
