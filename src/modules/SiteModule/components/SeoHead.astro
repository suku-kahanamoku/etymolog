---
import { SEO } from "astro-seo";
import { locales, type Locale } from "../../LangModule/config";
import { url, nameUrl, resolveName, type PageId } from "../../../config/routes";
import { site } from "../../../config/site";
/**
 * Metadáta stránky pro vyhledávače a sociální sítě (SiteModule).
 *
 * Kanonická adresa i `hreflang` odkazy se odvozují z trasy; u detailu jména se
 * použije překlad stejného záznamu do všech jazyků. Pro `noindex` stránky se
 * žádné alternativní jazykové verze nevykreslí, aby se neindexovaly duplicity.
 * Props: položky bez `?` jsou povinné, u volitelných uvádí popis výchozí hodnotu.
 */
interface Props {
  /** Aktuální jazyk webu. */
  locale: Locale;
  /** Aktuální stránka; `undefined` u detailu jména a chybových stavů. */
  page?: PageId;
  /** Titulek stránky (bez suffixu se značkou webu). */
  title: string;
  /** Popis stránky pro vyhledávače a náhledy. */
  description: string;
  /** Zakáže indexování a sledování odkazů; výchozí `false`. */
  noindex?: boolean;
}
const { locale, page, title, description, noindex = false } = Astro.props;
/** Trasa detailu jména, pokud je stránka detailem; jinak `undefined`. */
const nameRoute = resolveName(Astro.url.pathname);
/**
 * @param code Jazyk, pro který chceme adresu téže stránky.
 * @returns Kanonická cesta odpovídající danému jazyku.
 */
const localizedHref = (code: Locale) =>
  nameRoute ? nameUrl(code, nameRoute.id) : url(code, page);
/** Kanonická adresa stránky včetně originu webu. */
const canonical = new URL(
  page || nameRoute ? localizedHref(locale) : Astro.url.pathname,
  Astro.site,
);
---

<SEO
  title={`${title} | ${site.name}`}
  {description}
  canonical={canonical.href}
  {noindex}
  nofollow={noindex}
  openGraph={{
    basic: {
      title,
      type: "website",
      image: new URL("/social.webp", Astro.site).href,
      url: canonical.href,
    },
    optional: {
      description,
      siteName: site.name,
      locale: { cs: "cs_CZ", en: "en_GB", de: "de_DE" }[locale],
    },
  }}
  twitter={{ card: "summary_large_image" }}
/>
{!noindex && (page || nameRoute) && (
  <>
    {locales.map((code) => (
      <link
        rel="alternate"
        hreflang={code}
        href={new URL(localizedHref(code), Astro.site)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localizedHref("cs"), Astro.site)}
    />
  </>
)}
