---
import MainMenu from "../../UIModule/components/MainMenu.astro";
import "../styles/components.css";
import type { NavigationItem } from "../../UIModule/types";
import BrandMark from "./BrandMark.astro";
import LanguagePicker from "../../LangModule/components/LanguagePicker.astro";
import { site } from "../../../config/site";
import { dictionary } from "../providers/translations";
import { type Locale } from "../../LangModule/providers/locale";
import { url, nameUrl, resolveName, type PageId } from "../../../config/routes";
interface Props {
  locale: Locale;
  page?: PageId;
}
const { locale, page = "home" } = Astro.props;
const t = dictionary(locale);
const detailId = resolveName(Astro.url.pathname)?.id;
const links: NavigationItem[] = [
  { href: url(locale), label: t.nav.home, current: page === "home" },
  { href: url(locale, "about"), label: t.nav.about, current: page === "about" },
  {
    href: url(locale, "contact"),
    label: t.nav.contact,
    current: page === "contact",
  },
];
const mobileLinks: NavigationItem[] = site.modules.auth
  ? [
      ...links,
      {
        href: url(locale, "admin"),
        label: t.nav.admin,
        current: page === "account",
      },
    ]
  : links;
---

<MainMenu
  {locale}
  label={t.nav.menu}
  items={links}
  mobileItems={mobileLinks}
  framed
  showAction={site.modules.auth}
>
  <a slot="brand" class="brand" href={url(locale)} aria-label={site.name}>
    <BrandMark />
    {site.name}
  </a>
  <LanguagePicker
    slot="language"
    {locale}
    href={(code) => (detailId ? nameUrl(code, detailId) : url(code, page))}
  />
  {site.modules.auth && (
    <a
      slot="action"
      class="btn btn-sm btn-outline login-link"
      href={url(locale, "admin")}
    >
      {t.nav.admin}
    </a>
  )}
</MainMenu>
