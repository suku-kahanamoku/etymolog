---
import MainMenu from "../../UIModule/components/MainMenu.astro";
import "../styles/components.css";
import type { NavigationItem } from "../../UIModule/types";
import BrandMark from "./BrandMark.astro";
import LanguagePicker from "../../LangModule/components/LanguagePicker.astro";
import { site } from "../../../config/site";
import { dictionary } from "../providers/translations";
import { type Locale } from "../../LangModule/providers/locale";
import { url, nameUrl, resolveName, type PageId } from "../../../config/routes";
/**
 * Hlavička webu (SiteModule) sestavená nad `MainMenu` UIModule.
 *
 * Odkazy navigace se generují z překladů a helperu `url()`; přepínač jazyků
 * si ponechává aktuální stránku i detail jména. Slot `action` (tlačítko
 * administrace) se vykreslí jen při zapnutém modulu autentizace.
 * Props: položky bez `?` jsou povinné, u volitelných uvádí popis výchozí hodnotu.
 */
interface Props {
  /** Aktuální jazyk webu. */
  locale: Locale;
  /** Aktuální stránka; výchozí `home` (slouží ke zvýraznění aktivní položky). */
  page?: PageId;
}
const { locale, page = "home" } = Astro.props;
const t = dictionary(locale);
/** ID detailu jména z adresy; `undefined` mimo stránku jména. */
const detailId = resolveName(Astro.url.pathname)?.id;
/** Položky hlavní navigace s příznakem aktivní stránky. */
const links: NavigationItem[] = [
  { href: url(locale), label: t.nav.home, current: page === "home" },
  { href: url(locale, "about"), label: t.nav.about, current: page === "about" },
  {
    href: url(locale, "contact"),
    label: t.nav.contact,
    current: page === "contact",
  },
];
/**
 * Odkazy mobilního panelu. Odkaz na administraci se přidává pouze při zapnutém
 * modulu autentizace; oprávnění se ale řeší až na serveru, jde jen o zobrazení.
 */
const mobileLinks: NavigationItem[] = site.modules.auth
  ? [
      ...links,
      {
        href: url(locale, "admin"),
        label: t.nav.admin,
        current: page === "account",
      },
    ]
  : links;
---

<MainMenu
  {locale}
  label={t.nav.menu}
  items={links}
  mobileItems={mobileLinks}
  framed
  showAction={site.modules.auth}
>
  <a slot="brand" class="brand" href={url(locale)} aria-label={site.name}>
    <BrandMark />
    {site.name}
  </a>
  <LanguagePicker
    slot="language"
    {locale}
    href={(code) => (detailId ? nameUrl(code, detailId) : url(code, page))}
  />
  {site.modules.auth && (
    <a
      slot="action"
      class="btn btn-sm btn-outline login-link"
      href={url(locale, "admin")}
    >
      {t.nav.admin}
    </a>
  )}
</MainMenu>
