---
import "../styles/components.css";
import Section from "../../UIModule/components/Section.astro";
import { dictionary } from "../providers/translations";
import { type Locale } from "../../LangModule/providers/locale";
import { url } from "../../../config/routes";
/**
 * Chybová stránka pro stavy 404 a 503 (SiteModule).
 *
 * Texty se volí podle propu `status`; komponenta sama nenastavuje HTTP stav
 * odpovědi, to dělá routa v `src/pages/[...path].astro`.
 * Props: položky bez `?` jsou povinné, u volitelných uvádí popis výchozí hodnotu.
 */
interface Props {
  /** Jazyk, ve kterém se vykreslí popisky. */
  locale: Locale;
  /** Kód chyby (`404` nebo `503`). */
  status: 404 | 503;
}
const { locale, status } = Astro.props;
const t = dictionary(locale);
---

<Section contentClass="content-section">
  <p class="eyebrow">{status}</p>
  <h1>{status === 404 ? t.errors.notFound : t.errors.unavailable}</h1>
  <p>
    {status === 404
      ? t.errors.notFoundDescription
      : t.errors.unavailableDescription}
  </p>
  <a class="btn btn-primary" href={url(locale)}>
    {t.common.back}
  </a>
</Section>
