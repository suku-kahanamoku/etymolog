# Stejne promenne jako v nuxt/fann. Backend bezi pres existujici PHP server.
PHP_API_BASE_URL=http://127.0.0.1/php/php-core/api
# Pouze serverovy klic; musi odpovidat INTERNAL_API_KEY v php-core.
INTERNAL_API_KEY=
# Verejny origin a pevny tenant: hostname musi byt v php-core FRANCHISE_CODES.
FRONTEND_HOST=http://etymolog.localhost:4321
# Optional public WebSocket endpoint, never put an API key or bearer token here.
PUBLIC_WEBSOCKET_URL=
# standalone Node binding
HOST=127.0.0.1
PORT=4321
